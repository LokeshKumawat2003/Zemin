  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo-zemin@gmail.com\",\n  \"password\": \"demo123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin",
                "login"
              ]
            },
            "description": "Login as demo admin. Accepts username or email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.tokens && json.data.tokens.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', json.data.tokens.accessToken);",
                  "  console.log('Admin token saved to collection variable');",
                  "}",
                  "else {",
                  "  console.log('No access token returned');",
                  "}",
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Register",
          "request": {
            "method": "POST",
            "header": [
