                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Violation of community guidelines\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/ban",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "ban"
              ]
            }
          }
        },
        {
          "name": "Get User Payment Methods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}/payment-methods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "payment-methods"
              ]
            },
            "description": "View the user's saved bank and UPI details. Handle returned bank details as sensitive data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const firstMethod = json && json.data && json.data.paymentMethods && json.data.paymentMethods[0];",
                  "if (firstMethod && (firstMethod._id || firstMethod.id)) pm.collectionVariables.set('paymentMethodId', firstMethod._id || firstMethod.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete User Payment Method",
