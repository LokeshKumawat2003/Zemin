    {
      "name": "Admin User Management",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=10&search=creator&role=creator&isBanned=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "creator", "description": "Matches username, displayName, or email" },
                { "key": "role", "value": "creator", "description": "fan, creator, moderator, or admin" },
                { "key": "isBanned", "value": "false", "description": "true or false" }
              ]
            },
            "description": "List users with pagination and optional search, role, and ban-status filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const firstUser = json && json.data && json.data[0];",
                  "if (firstUser && firstUser.id) pm.collectionVariables.set('userId', firstUser.id);",
                  "pm.test('Users loaded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
