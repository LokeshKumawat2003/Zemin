NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/Zemin
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit (optional — enables real WebRTC video for live streams)
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Push Notifications (Firebase Cloud Messaging)
# Option 1: paste full service account JSON as a single-line string
# Example: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"zemin-6a892","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----...","client_email":"firebase-adminsdk@...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/..."}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2: path to service account JSON file (alternative to Option 1)
GOOGLE_APPLICATION_CREDENTIALS=
# Set to false to disable push delivery while keeping in-app notifications
NOTIFICATION_PUSH_ENABLED=true